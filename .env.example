# Copy to .env and fill in. Format is strict: KEY=value, one per line,
# no quotes, no spaces around =, no multiline values. Lines starting with # are ignored.

# Comma separated name:sha256 pairs, one per device or channel.
# Generate each with: .venv/bin/python scripts/new_token.py <name>
API_TOKENS=

# Path to the SQLite database file.
DB_PATH=

# IANA timezone used for due dates and "today", e.g. America/New_York.
TIMEZONE=

# Address and port the server binds to. Keep 127.0.0.1 until exposure is decided in step 4.
HOST=
PORT=
